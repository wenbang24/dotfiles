# Generated by Spectre - Ghostty Config Generator
# https://github.com/imrajyavardhan12/spectre-ghostty-config

# Fonts
font-family = "Fira Code"
font-size = 20

# Colors
theme = "Catppuccin Mocha"

# Window
window-decoration = auto
window-padding-x = 6
window-padding-y = 6
window-padding-balance = true
macos-hidden = never

# Shell
working-directory = ~/Desktop/everything

# Macos
macos-icon-frame = plastic
macos-icon = chalkboard
macos-shortcuts = allow
macos-titlebar-style = hidden
macos-option-as-alt = left

# Quick-terminal
quick-terminal-position = bottom
quick-terminal-animation-duration = 0

keybind = global:super+ctrl+alt+shift+t=toggle_quick_terminal
